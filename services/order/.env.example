# App
APP_NAME=order
# Logger
LOG_LEVEL=debug
LOG_FORMAT=text
# Postgres
PG_DSN=postgresql://postgres:postgres@localhost:5432/orderdb?sslmode=disable
PG_MAX_CONNS=10
# gRPC Server
GRPC_SERVER_ADDR=:8090
GRPC_SERVER_REFLECTION=true
# User Service
USER_SERVICE_GRPC_ADDR=:8091
# Product Service
PRODUCT_SERVICE_GRPC_ADDR=:8092