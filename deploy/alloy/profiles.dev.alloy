// Конфиг Alloy для непрерывного профилирования в dev.
// Сервисы запущены через Air на хосте и доступны из контейнера как host.docker.internal:606x.
// Остановленный сервис даёт ошибки скрейпа в логах Alloy, остальные цели не затрагиваются.

pyroscope.write "pyroscope" {
	endpoint {
		url = "http://pyroscope:4040"
	}

	external_labels = {
		env = "dev",
	}
}

pyroscope.scrape "gateway" {
	targets = [
		{
			"__address__"  = "host.docker.internal:6060",
			"service_name" = "gateway",
		},
	]
	scrape_interval = "15s"
	forward_to      = [pyroscope.write.pyroscope.receiver]

	profiling_config {
		profile.process_cpu {
			enabled = true
		}

		profile.memory {
			enabled = true
		}

		profile.goroutine {
			enabled = true
		}

		profile.mutex {
			enabled = true
		}

		profile.block {
			enabled = true
		}
	}
}

